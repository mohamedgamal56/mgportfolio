# Supabase Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service Role Key (Server-only, used for admin seeding/setup if needed)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Your single admin email (server-only safeguard in middleware/notifications)
# ADMIN_EMAIL=your-email@example.com

# Optional: Public site canonical URL
# NEXT_PUBLIC_SITE_URL=https://mohamedgamalpro.com

# Optional: Free Email Notifications via Resend (3,000/month free)
# RESEND_API_KEY=re_xxxxxxxxx
# LEAD_NOTIFY_EMAIL=your-email@example.com
# RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional: Free Mobile Push Notifications via ntfy.sh or Telegram Bot
# NTFY_TOPIC=your-private-random-topic-name
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# Optional: Free Meta Pixel ID (from Meta Events Manager)
# NEXT_PUBLIC_META_PIXEL_ID=1234567890123456

# Optional: Free Google Analytics 4 Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
